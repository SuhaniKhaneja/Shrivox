# Single provider for everything -- reasoning + embeddings.
# Free via Google AI Studio (https://aistudio.google.com/apikey) - no card required
GOOGLE_API_KEY=your_google_ai_studio_key_here
REASONING_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

POSTGRES_DSN=postgresql+asyncpg://shrivox:shrivox@localhost:5432/shrivox

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change_me_to_a_long_random_string
# Chat tickets only authorize opening a WebSocket; 5-900 seconds allowed.
CHAT_TICKET_TTL_SECONDS=60

MAX_CONVERSATION_TURNS=30
SESSION_TTL_SECONDS=3600
LOG_LEVEL=INFO
ENVIRONMENT=development

# Failure policy (defaults shown; see README "Failure handling")
UPSTREAM_TIMEOUT_SECONDS=15          # per Gemini attempt
UPSTREAM_MAX_ATTEMPTS=3              # transient errors only; 4xx is never retried
UPSTREAM_RETRY_BACKOFF_SECONDS=0.5
TURN_TIMEOUT_SECONDS=45              # hard ceiling for one chat turn
MAX_MESSAGE_CHARS=2000
MAX_DOCUMENT_CHARS=200000
REDIS_TIMEOUT_SECONDS=2.0
